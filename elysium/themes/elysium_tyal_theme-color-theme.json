{
	"name": "elysium-tyal-theme",
	"type": "dark",
	"colors": {
		"editor.background": "#071014",
		"editor.foreground": "#d6f5f5",
		"activityBarBadge.background": "#00ffd0",
		"sideBarTitle.foreground": "#2a6f73",
		"editorCursor.foreground": "#00ffd0",
		"editorLineNumber.foreground": "#1f3b3b",
		"editorLineNumber.activeForeground": "#00ffd0",
		"editor.selectionBackground": "#00ffd033"
	},
	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#2ecc71",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Imports",
			"scope": [
				"keyword.control.import",
				"keyword.control.from.import"
			],
			"settings": {
				"foreground": "#00ff88",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Loops",
			"scope": [
				"keyword.control.loop",
				"keyword.control.for",
				"keyword.control.while"
			],
			"settings": {
				"foreground": "#ff3b3b",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#b084ff"
			}
		},
		{
			"name": "Keywords (def, lambda)",
			"scope": [
				"keyword.declaration.function",
				"storage.type.function.python",
				"keyword.control.lambda"
			],
			"settings": {
				"foreground": "#c792ea"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#7df9ff"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#bffcff"
			}
		},
		{
			"name": "Keywords general",
			"scope": [
				"keyword"
			],
			"settings": {
				"foreground": "#00ffd0"
			}
		}
	]
}
